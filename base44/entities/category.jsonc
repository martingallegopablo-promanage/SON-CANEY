{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": { "type": "string", "description": "Category name" },
    "description": { "type": "string", "description": "Short description of the category" },
    "image_url": { "type": "string", "description": "Category image URL" },
    "sort_order": { "type": "number", "description": "Display order" },
    "is_active": { "type": "boolean", "default": true, "description": "Whether category is visible" }
  },
  "required": ["name"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {},
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
