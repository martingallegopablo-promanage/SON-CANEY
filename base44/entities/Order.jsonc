{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": { "type": "string", "description": "Unique order number" },
    "status": {
      "type": "string",
      "enum": ["pending", "confirmed", "preparing", "ready", "picked_up", "delivered", "cancelled"],
      "default": "pending",
      "description": "Order status"
    },
    "order_type": {
      "type": "string",
      "enum": ["pickup", "delivery", "dine_in"],
      "description": "Order type"
    },
    "items": {
      "type": "array",
      "description": "Order items",
      "items": {
        "type": "object",
        "properties": {
          "menu_item_id": { "type": "string" },
          "name": { "type": "string" },
          "price": { "type": "number" },
          "quantity": { "type": "number" },
          "customizations": { "type": "array", "items": { "type": "string" } },
          "special_instructions": { "type": "string" },
          "image_url": { "type": "string" }
        }
      }
    },
    "subtotal": { "type": "number" },
    "tax": { "type": "number" },
    "delivery_fee": { "type": "number" },
    "total": { "type": "number" },
    "customer_name": { "type": "string" },
    "customer_phone": { "type": "string" },
    "customer_email": { "type": "string" },
    "delivery_address": { "type": "string" },
    "special_instructions": { "type": "string" },
    "estimated_ready_time": { "type": "string" },
    "payment_method": {
      "type": "string",
      "enum": ["cash", "card"],
      "description": "Payment method"
    }
  },
  "required": ["order_type", "items", "total"],
  "rls": {
    "create": { "created_by_id": "{{user.id}}" },
    "read": { "$or": [{ "created_by_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] },
    "update": { "$or": [{ "created_by_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] },
    "delete": { "$or": [{ "created_by_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] }
  }
}
